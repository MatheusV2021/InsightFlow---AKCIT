AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_EMBEDDING_DIMENSIONS=1536
DEMO_MODE=true
# No modo normal, usa Qdrant local e embeddings do provedor selecionado.
CHAT_RETRIEVAL=qdrant
QDRANT_PATH=database/qdrant
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=1536
VECTOR_SCORE_THRESHOLD=0.3
CHAT_AGENT_ENABLED=true
AGENT_MAX_TOOL_CALLS=4
AGENT_MAX_SEARCHES=3
# Alternativa: AI_PROVIDER=openai e as configurações abaixo.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
